# Copia este archivo a .env.local y completa con los datos de TU proyecto de Supabase
# (Project Settings -> API, en supabase.com). El plan Free no pide tarjeta de crédito.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Número de WhatsApp de la dueña/administradora, que recibe copia interna de cada cotización.
# Formato: código de país + número, sin +, sin espacios (ej: 573142406671)
NEXT_PUBLIC_OWNER_WHATSAPP=573142406671
